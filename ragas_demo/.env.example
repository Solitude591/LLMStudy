# 评测 LLM（DeepSeek 等 OpenAI 兼容接口）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
RAGAS_LLM_MODEL=deepseek-v4-pro

# 评测 embedding（须与 LLM 分开；text-embedding-v4 走 DashScope 兼容模式）
