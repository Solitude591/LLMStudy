{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s"
  },
  "mappings": {
    "dynamic": "strict",
    "_meta": {
      "schema_version": 4,
      "description": "RAG document segment index; header_path is searchable so section titles reach BM25"
    },
    "properties": {
      "vector": {
        "type": "dense_vector",
        "dims": 1536,
        "index": true,
        "similarity": "cosine",
        "index_options": {
          "type": "int8_hnsw"
        }
      },
      "text": {
        "type": "text",
        "analyzer": "ik_max_word",
        "search_analyzer": "ik_smart"
      },
      "metadata": {
        "type": "object",
        "dynamic": "strict",
        "properties": {
          "doc_id": {
            "type": "keyword",
            "ignore_above": 128
          },
          "version_id": {
            "type": "text",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 128
              }
            }
          },
          "parent_chunk_id": {
            "type": "keyword",
            "index": false,
            "doc_values": false
          },
          "header_path": {
            "type": "text",
            "analyzer": "ik_max_word",
            "search_analyzer": "ik_smart",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 512
              }
            }
          },
          "source_url": {
            "type": "keyword",
            "index": false,
            "doc_values": false
          },
          "page_start": {
            "type": "integer",
            "index": false,
            "doc_values": false
          },
          "page_end": {
            "type": "integer",
            "index": false,
            "doc_values": false
          },
          "language": {
            "type": "keyword",
            "ignore_above": 16
          }
        }
      }
    }
  }
}
